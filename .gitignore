# environments and caches
.venv/
__pycache__/
*.egg-info/
cache/
logs/

# fine-tuned checkpoints (large; rebuild with `flusight finetune`)
models/

# backtests: keep only the evaluation tables
backtests/*/*
!backtests/*/evaluation/

# revision analysis: row-level tables are large; rebuild with `flusight revisions`
forecasts/revisions/*-replay_rows.csv
forecasts/revisions/*-report_vs_final.csv

# local settings you don't want to share
flusight.local.toml
.env

# earlier runs moved aside by `flusight forecast` (local safety net; git history covers committed runs)
forecasts/archive/
